{
  "name": "kompass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first planner for projects, tasks, social media content and goals (Harada method). English and German.",
  "license": "MIT",
  "author": "ManyPi (https://manypi.com)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "server": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "app": "node launcher/kompass.mjs",
    "dev": "vite",
    "typecheck": "tsc -p web --noEmit",
    "build": "tsc -p web --noEmit && vite build",
    "start": "npm run build && npm run server"
  },
  "dependencies": {
    "@dicebear/core": "^9.4.3",
    "@dicebear/shapes": "^9.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
